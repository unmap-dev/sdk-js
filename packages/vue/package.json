{
  "name": "@unmap/vue",
  "version": "0.20.0",
  "description": "Vue 3 composables for the unmap platform: map, geocoder, directions",
  "license": "MIT",
  "keywords": [
    "unmap",
    "maps",
    "canada",
    "maplibre",
    "vue",
    "composables"
  ],
  "homepage": "https://unmap.dev/docs/start/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unmap-dev/sdk-js.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/unmap-dev/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unmap/sdk": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.4.0"
  }
}
