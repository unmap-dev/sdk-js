{
  "name": "@unmap/sdk",
  "version": "0.21.0",
  "description": "One key, the whole unmap platform: map + geocoder + router",
  "license": "MIT",
  "keywords": [
    "unmap",
    "maps",
    "canada",
    "maplibre",
    "geocoding",
    "routing",
    "sdk"
  ],
  "homepage": "https://unmap.dev/docs/start/quickstart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unmap-dev/sdk-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/unmap-dev/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unmap/core": "workspace:*",
    "@unmap/elevation": "workspace:*",
    "@unmap/geocoding": "workspace:*",
    "@unmap/maps": "workspace:*",
    "@unmap/routing": "workspace:*",
    "maplibre-gl": "^6.9.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
