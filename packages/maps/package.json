{
  "name": "@unmap/maps",
  "version": "0.21.0",
  "description": "unmap MapLibre GL renderer, wired to the unmap gateway",
  "license": "MIT",
  "keywords": [
    "unmap",
    "maps",
    "canada",
    "maplibre",
    "vector-tiles",
    "basemap"
  ],
  "homepage": "https://unmap.dev/docs/apis/maps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unmap-dev/sdk-js.git",
    "directory": "packages/maps"
  },
  "bugs": {
    "url": "https://github.com/unmap-dev/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unmap/core": "workspace:*"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.9.0"
  },
  "devDependencies": {
    "maplibre-gl": "^6.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
