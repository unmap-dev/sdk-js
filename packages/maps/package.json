{
  "name": "@unmap/maps",
  "version": "0.32.0",
  "description": "unmap MapLibre GL renderer, wired to the unmap gateway",
  "license": "MIT",
  "keywords": [
    "unmap",
    "maps",
    "canada",
    "maplibre",
    "vector-tiles",
    "basemap",
    "geocoder"
  ],
  "homepage": "https://unmap.dev/docs/apis/maps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unmap-dev/sdk-js.git",
    "directory": "packages/maps"
  },
  "bugs": {
    "url": "https://github.com/unmap-dev/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geocoder": {
      "types": "./dist/geocoder.d.ts",
      "import": "./dist/geocoder.js"
    },
    "./tiles": {
      "types": "./dist/tiles.d.ts",
      "import": "./dist/tiles.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unmap/core": "workspace:*",
    "@unmap/geocoding": "workspace:*",
    "@mapbox/vector-tile": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "pbf": "^5.1.2"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.9.0",
    "@maplibre/maplibre-gl-geocoder": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@maplibre/maplibre-gl-geocoder": {
      "optional": true
    }
  },
  "devDependencies": {
    "maplibre-gl": "^6.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "@maplibre/maplibre-gl-geocoder": "1.9.4",
    "@maplibre/vt-pbf": "4.3.2",
    "@maplibre/geojson-vt": "6.1.2"
  }
}
