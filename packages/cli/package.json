{
  "name": "@unmap/cli",
  "version": "0.21.0",
  "description": "unmap command-line tool: verify a key and scaffold a project",
  "license": "MIT",
  "keywords": [
    "unmap",
    "cli",
    "maps",
    "canada"
  ],
  "homepage": "https://unmap.dev/docs/start/quickstart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unmap-dev/sdk-js.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/unmap-dev/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "unmap": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unmap/core": "workspace:*",
    "@unmap/geocoding": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
