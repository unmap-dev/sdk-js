{
  "name": "@unmap/routing",
  "version": "0.21.0",
  "description": "Typed client for the unmap routing API (route + isochrone)",
  "license": "MIT",
  "keywords": [
    "unmap",
    "routing",
    "directions",
    "isochrone",
    "valhalla",
    "canada"
  ],
  "homepage": "https://unmap.dev/docs/apis/routing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unmap-dev/sdk-js.git",
    "directory": "packages/routing"
  },
  "bugs": {
    "url": "https://github.com/unmap-dev/sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unmap/core": "workspace:*"
  },
  "devDependencies": {
    "@unmap/optimize-schema": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
